{
  "name": "@agento/reporting",
  "version": "0.1.0",
  "private": true,
  "description": "Evidence-linked developer security reports in JSON and Markdown",
  "type": "module",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist"],
  "engines": { "node": "^22.22.3 || >=24.8.0" },
  "scripts": {
    "build": "node node_modules/typescript/bin/tsc -p tsconfig.build.json",
    "typecheck": "node node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run build && npm test"
  },
  "dependencies": { "@agento/core": "file:../core", "@agento/evidence": "file:../evidence" },
  "devDependencies": {
    "@agento/a01": "file:../a01", "@agento/a02": "file:../a02", "@agento/a05": "file:../a05",
    "@types/node": "^26.6.5", "typescript": "^7.0.2", "vitest": "^5.0.3"
  }
}
