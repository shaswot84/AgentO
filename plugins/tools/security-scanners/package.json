{
  "name": "@agento/security-scanners",
  "version": "0.1.0",
  "private": true,
  "description": "Bounded Nuclei, ZAP, Dalfox and sqlmap adapters with canonical results",
  "type": "module",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist", "templates"],
  "engines": { "node": "^22.22.3 || >=24.8.0" },
  "scripts": {
    "build": "node node_modules/typescript/bin/tsc -p tsconfig.build.json",
    "typecheck": "node node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "AGENTO_SCANNERS_INTEGRATION=1 vitest run test/native.integration.test.ts",
    "check": "npm run typecheck && npm run build && npm test"
  },
  "dependencies": {
    "@agento/core": "file:../../../packages/core",
    "@agento/runtime": "file:../../../packages/runtime"
  },
  "devDependencies": {
    "@agento/capability-registry": "file:../../../packages/capability-registry",
    "@agento/policy-engine": "file:../../../packages/policy-engine",
    "@types/node": "^26.6.5", "typescript": "^7.0.2", "vitest": "^5.0.3"
  }
}
