{
  "name": "@agento/remediation",
  "version": "0.1.0",
  "private": true,
  "description": "Source-bound Express repair suggestions and security regression tests",
  "type": "module",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist"],
  "engines": { "node": "^22.22.3 || >=24.8.0" },
  "scripts": {
    "build": "node node_modules/typescript/bin/tsc -p tsconfig.build.json",
    "typecheck": "node node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run build && npm test"
  },
  "dependencies": { "@agento/core": "file:../../packages/core", "@agento/evidence": "file:../../packages/evidence" },
  "devDependencies": { "@agento/reporting": "file:../../packages/reporting", "@types/node": "^26.6.5", "typescript": "^7.0.2", "vitest": "^5.0.3" }
}
