# Ollama Cloud / OpenAI-Compatible Configuration Template
# Copy this file to .env and configure your credentials.
OPENAI_API_KEY=your_openai_or_ollama_api_key_here
OPENAI_BASE_URL=https://ollama.com/v1
OPENAI_MODEL=gemma4:31b

# Ollama-specific configuration aliases
OLLAMA_API_KEY=your_openai_or_ollama_api_key_here
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_MODEL=gemma4:31b

# Static Analysis Tooling
# Optional path to pinned Semgrep executable (defaults to /tmp/agento-semgrep-venv/bin/semgrep or system PATH)
AGENTO_SEMGREP_EXECUTABLE=/tmp/agento-semgrep-venv/bin/semgrep
