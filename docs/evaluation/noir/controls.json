{
  "schemaVersion": 1,
  "description": "Source-only parser controls; no target dependencies installed and no target module executed.",
  "cases": [
    {
      "id": "mixed-client",
      "expected": [
        {
          "method": "GET",
          "path": "/server"
        }
      ],
      "forbidden": [
        {
          "method": "GET",
          "path": "/outbound"
        },
        {
          "method": "GET",
          "path": "/client-only"
        },
        {
          "method": "GET",
          "path": "/fake-only"
        }
      ],
      "arms": {
        "agento": {
          "endpoints": [
            {
              "method": "GET",
              "path": "/server"
            }
          ],
          "expected": [
            {
              "method": "GET",
              "path": "/server",
              "matched": true
            }
          ],
          "forbidden": [
            {
              "method": "GET",
              "path": "/outbound",
              "matched": false
            },
            {
              "method": "GET",
              "path": "/client-only",
              "matched": false
            },
            {
              "method": "GET",
              "path": "/fake-only",
              "matched": false
            }
          ],
          "allExpectedFound": true,
          "noForbiddenFound": true
        },
        "noir": {
          "endpoints": [
            {
              "method": "GET",
              "path": "/server"
            }
